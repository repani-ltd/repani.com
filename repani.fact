company.contact_email: str = "hello@repani.com"
company.human_roles: list(str) = ["owner"]
company.jurisdiction: str = "Cyprus"
company.name: str = "Repani Limited"
company.registered_office: str = "118 Agias Fylaxeos Street, Christabel House, 3087 Limassol, Cyprus"
company.run_by: enum(agents|humans|mixed) = agents
company.site: str = "https://repani.com"
company.statement: str = "Repani builds the tools, the method and the agentic setup for delivering enterprise software with AI agents, and owns them as source code. The company is itself run by agents, with a human owner where it counts."
go.branch: str = "main"
go.latest_tag: str = "v0.2.1"
go.license: str = "Apache-2.0"
go.module: str = "repani.com"
go.projects: list(ref(project)) = [project:pica, project:fact, project:ascon, project:golay, project:lz4s]
go.releases: str = "https://github.com/repani-ltd/repani/releases"
go.repo: str = "https://github.com/repani-ltd/repani"
org.roles: list(ref(role)) = [role:build, role:run]
project:ascon.path: str = "repani.com/ascon"
project:ascon.summary: str = "Ascon-XOF128 and Ascon-AEAD128 as specified in NIST SP 800-232."
project:fact.cli: str = "go install repani.com/fact/cmd/fact@latest"
project:fact.path: str = "repani.com/fact"
project:fact.summary: str = "FACT, a line-oriented format for facts about systems, built for agents: one complete typed fact per line, no nesting, no external schema."
project:golay.path: str = "repani.com/golay"
project:golay.summary: str = "The extended Golay(24,12) code: systematic encoder and syndrome-table decoder, correcting up to 3 bit errors per codeword and detecting 4."
project:lz4s.path: str = "repani.com/lz4s"
project:lz4s.summary: str = "LZ4s: the LZ4 sequence architecture with its economics re-tuned for small texts."
project:pica.cli: str = "go install repani.com/pica/cmd/pica@latest"
project:pica.path: str = "repani.com/pica"
project:pica.summary: str = "A minimal, troff-inspired source language and typesetter: one parse to a typed block model, writers for fixed-width text and PDF."
role:build.scope: str = "the products: specifications, code and documentation"
role:run.scope: str = "the company's presence and operation: this site, publishing, operations and outreach"
site.agent_contract: str = "https://repani.com/AGENTS.md"
site.bundle: str = "https://repani.com/site.txtar"
site.renderer: str = "pica text (repani.com/pica); docs/build.sh"
site.sources: list(str) = ["src/index.t", "src/legal.t", "repani.fact", "AGENTS.md", "favicon.svg", "docs/mark/mark-colour.stream", "docs/mark/mark-mono.stream"]
site.updated: datetime = 2026-08-19
