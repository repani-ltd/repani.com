-- data.fact --
company.copyright_year: int = 2026
company.jurisdiction: str = "Cyprus"
company.name: str = "Repani Limited"
company.registered_office: str = "118 Agias Fylaxeos Street, Christabel House, 3087 Limassol, Cyprus"
company.site: str = "https://repani.com"
company.statement: str = "Repani takes on the software institutions have been told cannot be built or replaced, and turns it into routine work. Agents do the work. Fleet Engineers direct them and sign for it."
go.repo: str = "https://github.com/repani-ltd/repani"
reference.result: str = "The whole software was rewritten in six months, by less than half the team."
site.title: str = "Repani"
site.headline: str = "Make the impossible boring."
site.subhead: str = "The end of the software project."
site.fleet_engineer: str = "A Fleet Engineer takes a piece of work end to end with a fleet of agents, in parallel with others doing the same, vets what the agents produce, and signs for it."
site.fleet_engineer_skill: str = "Agents do not make the engineer cheaper. The role takes more experience and broader knowledge than the old specialisms did."
site.decision_desk: str = "The Decision Desk is what an operations team becomes when it no longer has to do the work."
site.decision_desk_judgment: str = "What is left is judgment."
site.decision_desk_shift: str = "Agents are not only the makers. In operations too, embedded agents, local and hosted, do the work, and people approve it."
site.decision_desk_people: str = "The experienced people on the desk are the stars. Engineers have seldom given their operations colleagues a thought. In this way of working, those colleagues are the point."
site.zero_handoff: str = "Every engineer takes their work from the first conversation to production, and nobody waits for anybody."
